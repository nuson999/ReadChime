{
  "name": "readchime",
  "version": "0.2.8",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:extension": "node scripts/build.mjs --watch",
    "build": "vite build && node scripts/build.mjs && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:firefox": "web-ext lint --source-dir dist",
    "firefox": "web-ext run --source-dir dist --start-url about:blank",
    "test:firefox": "node scripts/smoke-firefox.mjs",
    "test:firefox:library": "node scripts/smoke-library-firefox.mjs",
    "test:firefox:i18n": "node scripts/smoke-i18n-firefox.mjs",
    "test:firefox:reader": "node scripts/smoke-reader-firefox.mjs",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --filename readchime-{version}.zip --overwrite-dest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run validate:firefox"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "eslint": "^9.39.0",
    "geckodriver": "^8.0.0",
    "globals": "^16.4.0",
    "linkedom": "^0.18.13",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "web-ext": "^8.9.0"
  }
}
