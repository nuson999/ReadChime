{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "0.2.4",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "readchime@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://play.google.com/books*"],
  "background": { "scripts": ["background.js"], "persistent": false },
  "action": { "default_title": "__MSG_actionTitle__", "default_popup": "popup.html", "default_icon": { "48": "icons/book.svg", "96": "icons/book.svg" } },
  "icons": { "48": "icons/book.svg", "96": "icons/book.svg" },
  "content_scripts": [{ "matches": ["https://play.google.com/books*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
